# --- LLM primary: Magica (OpenAI-compatible; large token budget, no daily cap) ---
# Browse available models: https://inference.magica.com/v1/llm/models.json
# If unset, the app falls back to Groq below, then to a deterministic mock.
MAGICA_API_KEY=
MAGICA_BASE_URL=https://inference.magica.com/v1
MAGICA_MODEL=openai/gpt-4o-mini

# --- LLM fallback: Groq (free, OpenAI-compatible). Used if Magica fails. ---
# Free option for hackathons: Groq (https://console.groq.com).
# For real OpenAI instead, set GROQ_BASE_URL=https://api.openai.com/v1 and a gpt model.
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=openai/gpt-oss-120b

# --- Text-to-speech via Groq Orpheus. If unset, the frontend uses browser TTS. ---
# TTS_API_KEY falls back to GROQ_API_KEY. Valid voices: autumn diana hannah austin daniel troy
TTS_API_KEY=
TTS_BASE_URL=https://api.groq.com/openai/v1
TTS_MODEL=canopylabs/orpheus-v1-english
TTS_VOICE=austin
TTS_FORMAT=wav

# --- Speech-to-text. If unset, the frontend uses browser Web Speech (free). ---
STT_API_KEY=
STT_BASE_URL=https://api.openai.com/v1
STT_MODEL=whisper-1


# --- Google Sign-In. If unset, the frontend falls back to guest mode ---
# (device-local history only, no cross-device profile).
# Create a free OAuth Client ID (type "Web application") at
# https://console.cloud.google.com/apis/credentials — add your client dev
# URL (e.g. http://localhost:5173) and deployed URL under "Authorized
# JavaScript origins". Use the SAME client ID here and in client/.env
# (VITE_GOOGLE_CLIENT_ID) — this value is the token "audience" we verify.
GOOGLE_CLIENT_ID=

# Secret used to sign our own session tokens (separate from Google's).
# If unset, a random secret is generated at boot — fine for a demo, but
# signed-in sessions won't survive a server restart. Set any long random
# string here to keep users signed in across restarts.
JWT_SECRET=

# --- Server ---
PORT=4000
