# --- LLM (OpenAI-compatible). If unset, a deterministic mock LLM is used. ---
# Free option for hackathons: Groq (https://console.groq.com). Get a free key,
# then use its OpenAI-compatible endpoint below.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_MODEL=openai/gpt-oss-20b
# For real OpenAI instead, use:
#   OPENAI_BASE_URL=https://api.openai.com/v1
#   OPENAI_MODEL=gpt-4o-mini

# --- Text-to-speech. If unset, the frontend uses browser speech synthesis. ---
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL=eleven_turbo_v2

# --- Speech-to-text. If unset, the frontend uses browser Web Speech (free). ---
# Decoupled from the LLM provider so a free LLM (Groq) can coexist with either
# no STT (browser) or a separate STT provider.
STT_API_KEY=
STT_BASE_URL=https://api.openai.com/v1
STT_MODEL=whisper-1

# --- Server ---
PORT=4000
