# In dev, calls are same-origin and proxied to the server by Vite — leave
# this blank. In production (client and server deployed separately, e.g. on
# Render), set this to the deployed server's URL.
VITE_API_BASE_URL=

# --- Google Sign-In ---
# Must be the SAME OAuth Client ID as GOOGLE_CLIENT_ID in server/.env — this
# is the public "audience" value, safe to ship in the built frontend.
# If unset, the app runs in guest mode (device-local history only) instead
# of showing a broken sign-in button.
VITE_GOOGLE_CLIENT_ID=
